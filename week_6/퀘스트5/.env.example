# Supabase / PostgreSQL 연결 문자열 (실제 값은 .env 에 넣고 커밋하지 않는다)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
PORT=3000
# JWT 서명 비밀키 (긴 랜덤 문자열. 예: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=change-me-to-a-long-random-string
# 토스페이먼츠 시크릿키 (서버 결제 승인용). 테스트 상점 키 예: test_gsk_...
# ⚠️ 절대 프런트/깃에 노출하지 말 것. 실제 값은 .env 에만 넣는다.
TOSS_SECRET_KEY=test_gsk_your_secret_key_here
# ImageKit 프로필 사진 업로드용.
# PRIVATE 키만 서버 비밀(서명 생성용). PUBLIC/URL_ENDPOINT 는 공개돼도 안전.
IMAGEKIT_PRIVATE_KEY=private_your_private_key_here
IMAGEKIT_PUBLIC_KEY=public_your_public_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# AI 브리핑용 (사장님 대시보드)
OPENAI_API_KEY=sk-...

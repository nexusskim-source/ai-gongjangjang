{
  "version": 2,
  "builds": [
    { "src": "api/todos.js", "use": "@vercel/node" },
    { "src": "api/auth.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/auth/(login|signup)", "dest": "/api/auth.js" },
    { "src": "/api/todos", "dest": "/api/todos.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
